PROJECT_NAME="Muse API"
API_V1_STR="/api/v1"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Everything below is FREE by default. No paid API key is required.

# Conversation + critique: local Ollama (free, offline)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Vision: lets the app actually look at an artwork instead of only reading its
# title. Pull one first:  ollama pull moondream   (or llava / qwen2.5vl)
OLLAMA_VISION_MODEL="moondream"
VISION_ENABLED=True

# Image generation: "auto" = free-first waterfall
#   auto | pollinations | local_sd | huggingface | openai
IMAGE_PROVIDER="auto"
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
POLLINATIONS_MODEL="flux"        # free, keyless — the default path
SD_WEBUI_URL=""                  # optional: http://localhost:7860 (AUTOMATIC1111)
SD_STEPS=28
HUGGINGFACE_API_TOKEN=""         # optional, free tier
HUGGINGFACE_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
OPENAI_API_KEY=""                # optional and PAID — leave empty

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="muse_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/muse_db"

# JWT Security
SECRET_KEY="muse_super_secret_jwt_key_change_in_production_32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320 # 3 days

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
